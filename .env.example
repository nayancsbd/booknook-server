# MongoDB Connection String (Native Driver)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/booknook?retryWrites=true&w=majority

# Client Application URL (Next.js frontend)
CLIENT_URL=http://localhost:3000

# BetterAuth JWKS Endpoint for JWT verification
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Server Port
PORT=5000

